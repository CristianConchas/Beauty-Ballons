# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...tu-clave-anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...tu-service-role
